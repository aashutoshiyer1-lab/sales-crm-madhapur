# Firebase Realtime Database Config for Escape Time (Madhapur Branch)
# Copy this to .env and fill in your actual Firebase values
# When deploying to Vercel, add these same keys in Vercel Project Settings -> Environment Variables

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=escapetime-madhapur.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://escapetime-madhapur-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=escapetime-madhapur
VITE_FIREBASE_STORAGE_BUCKET=escapetime-madhapur.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
